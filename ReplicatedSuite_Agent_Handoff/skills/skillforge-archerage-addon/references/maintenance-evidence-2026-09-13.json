  "lessons": [
    {
      "id": "RS-L17",
      "title": "负整数回读差异",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "用户给出-2与0的canonical差异；源码保护负整数走已有n-token。无该次原始LoadData，Native内部原因仍是假设。",
      "reference": "persistence-and-diagnostics.md"
    },
    {
      "id": "RS-L18",
      "title": "后续保存失败未入导出",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "加载正常不反证后续durable失败；导出当前未解决失败而非只枚举加载fence。",
      "reference": "persistence-and-diagnostics.md"
    },
    {
      "id": "RS-L19",
      "title": "等待复制选区失效",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "用户报告延迟复制失败；不能据2秒推断定时SetText，应分查正文、几何和焦点。",
      "reference": "diagnostic-report-workflow.md"
    },
    {
      "id": "RS-L20",
      "title": "倒计时是真实时钟链",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "期限、调度、Presenter确认分别验证；长帧/重复采样不能延长同段读条。",
      "reference": "boss-alert-clock-and-layout.md"
    },
    {
      "id": "RS-L21",
      "title": "规则目录不是Boss全技能",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "少量静态规则与未收录实际读条不能证明瞬发或预测CD覆盖。",
      "reference": "boss-alert-clock-and-layout.md"
    },
    {
      "id": "RS-L22",
      "title": "敌人装备类型不是物品",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "当前Buff可证明类型，不能显示敌方具体物品；同类型切换不必变图。",
      "reference": "status-tracking-contracts.md"
    },
    {
      "id": "RS-L23",
      "title": "新增图标必须可校准",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "渲染/配置/校准/预览/导出/恢复闭环；自己目标不共用可变布局。",
      "reference": "hud-template-and-defaults.md"
    },
    {
      "id": "RS-L24",
      "title": "事件洪流不能饿死装备",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "实际Queue合并原因并保留最早期限；检查执行中重入与失败安排。",
      "reference": "pvp-hud-and-freshness.md"
    },
    {
      "id": "RS-L25",
      "title": "位置与内容分离",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "位置路径只跟随父容器，固定观察范围；不把理论间隔当实测性能。",
      "reference": "pvp-hud-and-freshness.md"
    },
    {
      "id": "RS-L26",
      "title": "原生拒写不推进渲染缓存",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
      "claim": "保持pcall/逻辑接受/无变化三个含义；纹理失败不缓存新路径为已显示。",
      "reference": "pvp-hud-and-freshness.md"
    },
    {
      "id": "RS-L27",
      "title": "模板复制要双层校验",
      "evidence_scope": "user symptoms + scoped source inspection; historical tests not rerun unless separately recorded",
